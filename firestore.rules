rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if true; // Allows demo/app user edits
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // School Profile collection
    match /schoolProfile/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Fees collection
    match /fees/{feeId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // AI Chat History collection
    match /aiHistory/{chatId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
